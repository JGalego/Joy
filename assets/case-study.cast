[69.045093, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[9A \u001b[3G\u001b[38;5;246mRead \u001b[1m5\u001b[22m files (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39m\u001b[1mKeep\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gstay\u001b[14Gyours,\u001b[21Gand\u001b[25GI\u001b[27Gchanged\u001b[35Gnone\u001b[40Gof\u001b[43Gthem:\r\u001b[1B  - \u001b[1mAt-least-once guarantee:\u001b[22m the claim is leased before the send, and the ack comes only after it (\u001b[38;5;153mworker.py:43-64\u001b[39m).\u001b[K\r\u001b[1B  -\u001b[5G\u001b[1mRetry policy:\u001b[19G\u001b[22mcapped\u001b[26Gexponential\u001b[38Gbackoff\u001b[46Gin\u001b[49G\u001b[38;5;153mDeliveryPolicy.next_retry_at\u001b[78G\u001b[39m(\u001b[38;5;153mmodel.py:36\u001b[39m),\u001b[93Gwith\u001b[98G\u001b[38;5;153mlease_seconds\u001b[112G\u001b[39mas\u001b[115Gthe\r\u001b[1B    lease duration.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mClaim transition:\u001b[22m \u001b[38;5;153mclaim_due\u001b[39m moves a row from \u001b[38;5;153mpending\u001b[39m or\u001b[61Gan\u001b[64Gexpired\u001b[72G\u001b[38;5;153msending\u001b[80G\u001b[39mto\u001b[83G\u001b[38;5;153msending\u001b[91G\u001b[39mand\u001b[95Gincrements\u001b[106G\u001b[38;5;153mattempts\u001b[39m\r\r\n\u001b[5G(\u001b[38;5;153mrepository.py:63\u001b[39m).\r\r\n\r\r\n\u001b[3GQuestions\u001b[13Gfor\u001b[17Gyou\u001b[21Gon\u001b[24Gthese:\r\r\n\u001b[3G-\u001b[5GShould\u001b[12Ga\u001b[14Gcrash-recovered\u001b[30Gredelivery\u001b[41Gwait\u001b[46Gonly\u001b[51Gfor\u001b[55Gthe\u001b[59Glease,\u001b[66Gas\u001b[69Git\u001b[72Gdoes\u001b[77Gnow,\u001b[82Gor\u001b[85Gfor\u001b[89Gbackoff\u001b[97Gas\u001b[100Gwell?\u001b[106GToday\u001b[112Ga\u001b[114Gcrash\r\r\n\u001b[5Gdoesn't\u001b[13Ggrow\u001b[18Gthe\u001b[22Gbackoff.\r\r\n\u001b[3G-\u001b[5GShould\u001b[12G\u001b[38;5;153mclaim_due\u001b[22G\u001b[39mever\u001b[27Ghand\u001b[32Gout\u001b[36Ga\u001b[38Gdelivery\u001b[47Gthat\u001b[52Ghas\u001b[56Gno\u001b[59Gattempt\u001b[67Glimit?\u001b[74GThere\u001b[80Gis\u001b[83Gno\u001b[86Gdead-letter\u001b[98Gpolicy,\u001b[106Gand\u001b[110Gthe\u001b[114GREADME\r\r\n\u001b[5Galready\u001b[13Gsays\u001b[18Gso.\r\r\n\r\r\n\u001b[3G\u001b[1mPair\u001b[22m\r\r\n\r\r\n\u001b[3GThe\u001b[7Gsend-before-ack\u001b[23Gtimeline,\u001b[33Gas\u001b[36Gthe\u001b[40Gcode\u001b[45Gbehaves\u001b[53Gnow:\r\r\n\u001b[3G1.\u001b[6GAt\u001b[9Gt=100\u001b[15Gthe\u001b[19Gworker\u001b[26Gclaims\u001b[33Gthe\u001b[37Grow\u001b[41G(\u001b[38;5;153mattempts=1\u001b[39m,\u001b[54G\u001b[38;5;153mlease_until=105\u001b[39m)\u001b[71Gand\u001b[75Gthe\u001b[79Gsend\u001b[84Gsucceeds.\r\r\n\u001b[3G2.\u001b[6GIt\u001b[9Gcrashes\u001b[17Gbefore\u001b[24G\u001b[38;5;153mmark_delivered\u001b[39m,\u001b[40Gso\u001b[43Gthe\u001b[47Grow\u001b[51Gstays\u001b[57Gin\u001b[60G\u001b[38;5;153msending\u001b[39m.\r\r\n\u001b[3G3.\u001b[6GAt\u001b[9Gt=104\u001b[15G\u001b[38;5;153mclaim_due\u001b[25G\u001b[39mfinds\u001b[31Gnothing,\u001b[40Gbecause\u001b[48G\u001b[38;5;153mlease_until\u001b[60G<=\u001b[63Gnow\u001b[67G\u001b[39mis\u001b[70Gfalse.\r\r\n\u001b[3G4.\u001b[6GAt\u001b[9Gt=105\u001b[15Gthe\u001b[19Glease\u001b[25Ghas\u001b[29Gexpired,\u001b[38Gso\u001b[41Gthe\u001b[45Grow\u001b[49Gis\u001b[52Greclaimed\u001b[62G(\u001b[38;5;153mattempts=2\u001b[39m)\u001b[75Gand\u001b[79Gsent\u001b[84Gagain\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gkey.\u001b[109GThe\u001b[113Gack\u001b[117Gthen\r\r\n\u001b[6Gsucceeds.\r\r\n\r\r\n\u001b[3GOpen\u001b[8Gpoints\u001b[15Gfor\u001b[19Gus\u001b[22Gto\u001b[25Gdiscuss:\r\r\n\u001b[3G-\u001b[5G\u001b[1mGeneration\u001b[16Gand\u001b[20Gattempt\u001b[28Gcount:\u001b[35G\u001b[22m\u001b[38;5;153mattempts\u001b[44G\u001b[39mdoes\u001b[49Gboth\u001b[54Gjobs.\u001b[60GThat\u001b[65Gis\u001b[68Gfine\u001b[73Gwhile\u001b[79Gevery\u001b[85Gclaim\u001b[91Gis\u001b[94Gan\u001b[97Gattempt,\u001b[106Gbut\u001b[110Gyou\u001b[114Gwould\r\r\n\u001b[5Ghave\u001b[10Gto\u001b