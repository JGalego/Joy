[13.162412, "o", "\u001b[?2026h\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m●\u001b[3G\u001b[39m\u001b[1mKeep:\u001b[22m the slugify algorithm:\u001b[32Gyour\u001b[37Gpipeline,\u001b[47Gstep\u001b[52Gorder,\u001b[59Gand\u001b[63Grules.\r\u001b[2B  \u001b[1mPair:\u001b[22m\u001b[K\r\u001b[1B  -\u001b[5GUnicode\u001b[13Gnormalization:\u001b[28GNFKD\u001b[33Gvs\u001b[36GNFC,\u001b[41Gwhether\u001b[49Gto\u001b[52Gstrip\u001b[58Gcombining\u001b[68Gmarks\u001b[74G(\u001b[38;5;153mé\u001b[39m→\u001b[38;5;153me\u001b[39m),\u001b[81Gand\u001b[85Gwhat\u001b[90Gto\u001b[93Gdo\u001b[96Gwith\u001b[101Gnon-decomposable\r\u001b[1B    letters (\u001b[38;5;153mß\u001b[39m, \u001b[38;5;153mø\u001b[39m, \u001b[38;5;153mđ\u001b[39m) and non-Latin scripts (transliterate, keep, or drop).\u001b[K\r\u001b[2C\u001b[1B- Edge inputs: emoji and symbols, full-width forms, zero-width\u001b[66Gcharacters,\u001b[78Gand\u001b[82Ga\u001b[84Gresult\u001b[91Gthat\u001b[96Gcomes\u001b[102Gout\u001b[106Gempty.\r\r\n\r\r\n\u001b[3G\u001b[1mDelegate:\u001b[13G\u001b[22mone\u001b[17Gpytest\u001b[24Gexample,\u001b[33Gbelow.\r\r\n\r\r\n\u001b[3G\u001b[94mdef\u001b[7G\u001b[33mtest_slugify_strips_accents\u001b[39m():\r\r\n\u001b[7G\u001b[94massert\u001b[14G\u001b[39mslugify(\u001b[31m\"Crème\u001b[29GBrûlée\"\u001b[39m)\u001b[38G==\u001b[41G\u001b[31m\"creme-brulee\"\u001b[39m\r\r\n\r\r\n\u001b[38;5;246m✻\u001b[3GCrunched\u001b[12Gfor\u001b[16G4s\u001b[19G·\u001b[21Gdone\u001b[26G3:31\u001b[31GPM\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n❯ \u001b[7m \u001b[27m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?2026l"]
